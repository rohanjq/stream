# Secrets only. Copy this file to .env and set mode 600.
# Never commit .env or paste its values into logs/issues.

# YouTube ingest destination, including the private stream key.
YOUTUBE_RTMP_URL=rtmps://a.rtmp.youtube.com/live2/replace-with-stream-key

# OAuth client with YouTube Data API access. A refresh token is sufficient;
# the service obtains and rotates short-lived access tokens itself.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_TOKEN_EXPIRY=0
YOUTUBE_LIVE_CHAT_ID=
# Leave empty in production; the mock guide documents the local HTTP endpoint.
YOUTUBE_PUBLISH_URL=
YOUTUBE_IGNORE_OWNER=true
# Comma-separated immutable IDs for production. Author names are mock-only.
YOUTUBE_ALLOWED_CHANNEL_IDS=
YOUTUBE_ALLOWED_AUTHORS=

# AI host backend. Leave the key empty to use built-in fallback answers.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Durable AI host defaults. Public scheduling policy belongs in stream.env;
# these may be overridden here for a deployment without changing source.
AGENT_ENABLED=true
AGENT_COMMENTARY_INTERVAL_SECONDS=120
AGENT_MEMORY_THRESHOLD_COMMENTS=10
AGENT_ASSET_LABEL=Bitcoin

# Required for any control endpoint exposed outside the container.
# Generate with: openssl rand -hex 32
CONTROL_TOKEN=replace-with-a-long-random-token

# Keep localhost unless access is protected by a firewall/reverse proxy.
STREAM_BIND_ADDRESS=127.0.0.1
OPERATOR_HOST_PORT=8082
APP_CPUS=4.0
COMPOSITOR_CPUS=2.0
