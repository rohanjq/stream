# Safe, versioned runtime configuration. Secrets belong in root .env.

# Video / ingest
WIDTH=1280
HEIGHT=720
FPS=30
VBITRATE=4000k
GST_VBITRATE_KBPS=4000
ENC_THREADS=2
DEC_THREADS=2
STALL_TIMEOUT_S=20
STARTUP_GRACE_S=75

# Public scene and chart source
SCENE_PORT=8080
CONTROL_PORT=7800
OHLC_WS_URL=ws://host.containers.internal:18081/ws
OHLC_SYMBOL=BTCUSDT

# Audio
MUSIC_VOLUME=0.35
MUSIC_CONTROL_PORT=8091
PULSE_LATENCY_MSEC=200
KOKORO_VOICE=af_nicole
TTS_TARGET_I=-16
SPEECH_GAP_SECONDS=2
SPEECH_LIPSYNC_LEAD_SECONDS=0.35

# YouTube live chat
YOUTUBE_CHAT_TRANSPORT=grpc
YOUTUBE_GRPC_TARGET=youtube.googleapis.com:443
YOUTUBE_GRPC_INSECURE=false
YOUTUBE_SPEAK_MODE=all
YOUTUBE_SPEAK_COOLDOWN=0
YOUTUBE_IGNORE_OWNER=false
AUDIENCE_COMMAND_ROUTER=hybrid

# Durable operator/music state
STATE_DIR=/var/lib/nightshift
PERSIST_STATE=true
