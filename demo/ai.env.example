# Azure DeepSeek (or any OpenAI-compatible chat completions endpoint).
# Copy this file to ai.env and fill in your own values — ai.env is
# gitignored and must never be committed.
#
# Verified working call shape for an Azure AI Foundry serverless deployment:
#   POST {DEEPSEEK_URL}/chat/completions
#   Authorization: Bearer <DEEPSEEK_KEY>
#   (no api-version query param — that's the Azure-OpenAI convention, not
#   used by this endpoint type)
#
# If the endpoint is IP-allowlisted, whichever machine runs this container
# needs its egress IP added to the Azure resource's network rules first,
# or every chat request will 403 and the app falls back to a canned
# responder (see ai.py) instead of a real model reply.
DEEPSEEK_URL=https://your-resource.services.ai.azure.com/models
DEEPSEEK_KEY=
DEEPSEEK_MODEL=DeepSeek-V4-Flash
